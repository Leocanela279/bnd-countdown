---
// SpiderBackground.astro - A clean canvas-based interactive web effect
---

<div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden" id="spidey-net-container">
  <canvas id="spidey-net-canvas" class="w-full h-full opacity-40 md:opacity-30"></canvas>
</div>

<script>
  const canvas = document.getElementById('spidey-net-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    // Dynamic particle count based on screen size (increased for higher DNA/web density)
    const particleCount = width < 768 ? 65 : 140;
    const connectionDistance = 150;
    const particles: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      color: string;
    }> = [];

    let mouse = { x: -1000, y: -1000, active: false };

    // Initialize particles
    for (let i = 0; i < particleCount; i++) {
      // 75% white-ish, 25% spidey-red particles for vibrant accents
      const isRed = Math.random() > 0.75;
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        radius: Math.random() * 2.2 + 1.2, // Increased radius for higher visibility
        color: isRed ? 'rgba(230, 36, 41, 0.85)' : 'rgba(255, 255, 255, 0.55)', // Increased opacity
      });
    }

    // Handle resize
    let resizeTimeout: any;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (!canvas) return;
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }, 200);
    });

    // Track mouse
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
    });

    window.addEventListener('mouseleave', () => {
      mouse.active = false;
      mouse.x = -1000;
      mouse.y = -1000;
    });

    // Animation Loop
    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, width, height);

      // Draw connections & update particles
      for (let i = 0; i < particles.length; i++) {
        const p1 = particles[i];

        // Update positions
        p1.x += p1.vx;
        p1.y += p1.vy;

        // Bounce boundaries
        if (p1.x < 0 || p1.x > width) p1.vx *= -1;
        if (p1.y < 0 || p1.y > height) p1.vy *= -1;

        // Draw particle node
        ctx.beginPath();
        ctx.arc(p1.x, p1.y, p1.radius, 0, Math.PI * 2);
        ctx.fillStyle = p1.color;
        ctx.fill();

        // Mouse interaction: attract particles
        if (mouse.active) {
          const dx = p1.x - mouse.x;
          const dy = p1.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 180) {
            // Force factor: pull gently towards the cursor
            const force = (180 - dist) / 180;
            p1.x -= dx * force * 0.03;
            p1.y -= dy * force * 0.03;
          }
        }

        // Connect particles
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < connectionDistance) {
            // Draw transparent web connection
            const alpha = (1 - dist / connectionDistance) * 0.32; // Increased line intensity
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = p1.color.includes('230') 
              ? `rgba(230, 36, 41, ${alpha * 0.8})` 
              : `rgba(255, 255, 255, ${alpha * 0.55})`;
            ctx.lineWidth = p1.color.includes('230') ? 0.9 : 0.5;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    }

    draw();
  }
</script>
