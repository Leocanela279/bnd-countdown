---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Get ready for the release of Spider-Man: Brand New Day on July 31, 2026. Follow the countdown, watch the trailer, and get exclusive details!" 
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://spidey-brand-new-day.vercel.app/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://spidey-brand-new-day.vercel.app/og-image.jpg" />
    <meta property="og:image:secure_url" content="https://spidey-brand-new-day.vercel.app/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:site_name" content="Spider-Man Brand New Day Countdown" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://spidey-brand-new-day.vercel.app/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://spidey-brand-new-day.vercel.app/og-image.jpg" />
    <meta name="twitter:site" content="@Marvel" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="spidey-grid text-white min-h-screen flex flex-col selection:bg-spidey-red selection:text-white">
    <!-- Main top blue glow overlay (strengthened) -->
    <div class="fixed inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,102,255,0.45)_0%,rgba(3,3,3,1)_80%)] -z-20 pointer-events-none"></div>
    
    <!-- Ambient blue glows at the sides/edges (alrededores) -->
    <div class="fixed top-1/4 -left-32 w-[30rem] h-[30rem] rounded-full bg-[rgba(0,102,255,0.35)] blur-[140px] pointer-events-none -z-20"></div>
    <div class="fixed bottom-1/4 -right-32 w-[30rem] h-[30rem] rounded-full bg-[rgba(0,102,255,0.35)] blur-[140px] pointer-events-none -z-20"></div>
    
    <slot />
  </body>
</html>
